# Fuente cruda del polígono de costa (55MB, zip + shapefile) — regenerable
# desde osmdata.openstreetmap.de con build-coastline-compact.js. Solo se
# versionan los derivados livianos (coastline_compact.json / _fallback.json).
src/services/data/coastline/land-polygons/
src/services/data/coastline/regional/
